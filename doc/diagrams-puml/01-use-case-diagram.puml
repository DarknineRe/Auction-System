@startuml
title Use Case Diagram - Auction System
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Guest" as Guest
actor "User\n(Bidder / Buyer)" as User
actor "Seller" as Seller
actor "Admin" as Admin
actor "System\nScheduler" as Sched

User <|-- Seller

rectangle "Auction System" {
  package "Account" {
    usecase "UC01 Register" as UC01
    usecase "UC02 Login / Logout" as UC02
    usecase "UC03 Manage own profile\nand password" as UC03
    usecase "UC04 Create / Update\nSeller Profile" as UC04
  }

  package "Artwork and Bidding" {
    usecase "UC05 Browse biddings\nand artworks" as UC05
    usecase "UC06 Manage own artworks" as UC06
    usecase "UC07 Open bidding" as UC07
    usecase "UC08 Edit / Cancel\nown bidding" as UC08
    usecase "UC09 Place bid" as UC09
    usecase "UC10 View bid history\nand highest bid" as UC10
    usecase "UC11 Comment on bidding" as UC11
    usecase "UC12 Like / Dislike comment" as UC12
  }

  package "Payment and Shipping" {
    usecase "UC13 Submit payment slip" as UC13
    usecase "UC14 Confirm / Reject slip" as UC14
    usecase "UC15 Ship item" as UC15
    usecase "UC16 Rate seller" as UC16
    usecase "UC17 View purchases / sales" as UC17
  }

  package "Administration" {
    usecase "UC18 Manage users\n(enable / disable)" as UC18
    usecase "UC19 Close / Cancel bidding" as UC19
    usecase "UC20 Void bid" as UC20
    usecase "UC21 Delete artwork / comment" as UC21
    usecase "UC22 Cancel payment" as UC22
  }

  package "Automatic" {
    usecase "UC23 Close expired bidding\nand create payment" as UC23
    usecase "UC24 Expire overdue payment" as UC24
    usecase "UC25 Create payment\nfor winner" as UC25
  }
}

Guest --> UC01
Guest --> UC02
Guest --> UC05

User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC09
User --> UC10
User --> UC11
User --> UC12
User --> UC13
User --> UC16
User --> UC17

Seller --> UC06
Seller --> UC07
Seller --> UC08
Seller --> UC14
Seller --> UC15
Seller --> UC17

Admin --> UC18
Admin --> UC19
Admin --> UC20
Admin --> UC21
Admin --> UC22

Sched --> UC23
Sched --> UC24

UC09 .> UC10 : <<include>>
UC23 .> UC25 : <<include>>
UC19 .> UC25 : <<include>>

note bottom of Seller
  Seller = User ที่มี Seller Profile
  จึงใช้ use case ของ User ได้ทั้งหมด
end note
@enduml
